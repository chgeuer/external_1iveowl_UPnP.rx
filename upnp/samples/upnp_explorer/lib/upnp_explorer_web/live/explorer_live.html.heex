<Layouts.app flash={@flash} active="devices">
  <div id="network-explorer" class="mx-auto w-full max-w-[1800px] px-3 pb-5 sm:px-5">
    <div class="grid min-h-[calc(100dvh-5rem)] gap-3 lg:grid-cols-[18rem_minmax(0,1fr)] xl:grid-cols-[19rem_minmax(0,1fr)_20rem]">
      <section
        id="device-roster-panel"
        class={[
          "flex min-h-0 flex-col overflow-hidden rounded-lg border border-[var(--line)] bg-[var(--surface)]",
          @selected_device && "hidden lg:flex"
        ]}
      >
        <header class="border-b border-[var(--line)] px-4 pb-3 pt-4">
          <div class="flex items-start justify-between gap-3">
            <div>
              <p class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--text-faint)]">
                Home network
              </p>
              <div class="mt-1 flex items-baseline gap-2">
                <h1 class="text-lg font-semibold tracking-[-0.025em] text-[var(--text)]">
                  Devices
                </h1>
                <span
                  id="device-count"
                  class="font-mono text-xs text-[var(--text-muted)]"
                >
                  {@status.device_count}
                </span>
              </div>
            </div>
            <button
              id="probe-network"
              type="button"
              phx-click="probe"
              disabled={@probing? || !@status.network_available?}
              class="ui-icon-button"
              title="Send one M-SEARCH"
            >
              <.icon
                name="hero-arrow-path"
                class={["size-4", @probing? && "motion-safe:animate-spin"]}
              />
              <span class="sr-only">Search the network now</span>
            </button>
          </div>

          <.form for={@filter_form} id="device-filter-form" phx-change="filter" class="mt-3">
            <div class="relative">
              <.icon
                name="hero-magnifying-glass"
                class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-[var(--text-faint)]"
              />
              <.input
                field={@filter_form[:q]}
                type="search"
                aria-label="Filter devices"
                placeholder="Name, maker, capability"
                autocomplete="off"
                phx-debounce="200"
                class="h-10 w-full rounded-md border border-[var(--line-strong)] bg-[var(--surface-raised)] py-2 pl-9 pr-3 text-sm text-[var(--text)] outline-none transition placeholder:text-[var(--text-faint)] focus:border-[var(--accent)] focus:ring-2 focus:ring-[var(--accent-soft)]"
              />
            </div>
          </.form>
        </header>

        <div class="min-h-0 flex-1 overflow-y-auto">
          <div
            id="device-roster"
            phx-update="stream"
            class="divide-y divide-[var(--line)]"
          >
            <.link
              :for={{dom_id, device} <- @streams.devices}
              id={dom_id}
              patch={~p"/devices/#{device.id}"}
              class={[
                "group grid min-h-[5.25rem] grid-cols-[2.5rem_minmax(0,1fr)] gap-3 px-4 py-3.5 transition duration-150 hover:bg-[var(--surface-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--accent)]",
                @selected_device && @selected_device.id == device.id &&
                  "bg-[var(--accent-soft)] shadow-[inset_3px_0_0_var(--accent)]"
              ]}
            >
              <span class="relative grid size-10 place-items-center overflow-hidden rounded-md border border-[var(--line-strong)] bg-[var(--surface-raised)] text-[var(--accent)]">
                <.icon name="hero-cube" class="size-5" />
                <img
                  :if={safe_http_url(device.icon_url)}
                  src={device.icon_url}
                  alt=""
                  class="absolute inset-0 size-full bg-[var(--surface-raised)] object-contain p-1"
                />
              </span>
              <span class="min-w-0">
                <span class="flex items-center justify-between gap-2">
                  <span class="truncate text-sm font-semibold tracking-[-0.01em] text-[var(--text)]">
                    {device.name}
                  </span>
                  <span
                    class={[
                      "size-1.5 shrink-0 rounded-full",
                      device.status == :online && "bg-[var(--success)]",
                      device.status == :degraded && "bg-[var(--warning)]",
                      device.status in [:describing, :discovered] && "bg-[var(--accent)]"
                    ]}
                    title={device_status_label(device.status)}
                  >
                    <span class="sr-only">{device_status_label(device.status)}</span>
                  </span>
                </span>
                <span class="mt-0.5 block truncate text-xs text-[var(--text-muted)]">
                  {device_subtitle(device)}
                </span>
                <span class="mt-2 flex items-center gap-2 font-mono text-[0.64rem] text-[var(--text-faint)]">
                  <span>{device.device_kind || "UPnP device"}</span>
                  <span aria-hidden="true">/</span>
                  <span>{device.service_count} services</span>
                </span>
              </span>
            </.link>
          </div>

          <div
            :if={@status.device_count == 0 && !@show_scan_help?}
            id="scan-skeleton"
            class="space-y-px"
          >
            <div :for={index <- 1..3} id={"scan-skeleton-#{index}"} class="flex gap-3 px-4 py-4">
              <span class="skeleton-block size-10 rounded-md"></span>
              <span class="flex-1 space-y-2 pt-0.5">
                <span class="skeleton-block block h-3 w-2/3 rounded"></span>
                <span class="skeleton-block block h-2.5 w-1/2 rounded"></span>
                <span class="skeleton-block block h-2 w-1/3 rounded"></span>
              </span>
            </div>
          </div>

          <div
            :if={@status.device_count == 0 && @show_scan_help?}
            id="scan-help"
            class="m-3 rounded-lg border border-[var(--warning-border)] bg-[var(--warning-soft)] p-4"
          >
            <div class="flex gap-3">
              <.icon
                name="hero-signal-slash"
                class="mt-0.5 size-5 shrink-0 text-[var(--warning)]"
              />
              <div>
                <h2 class="text-sm font-semibold text-[var(--text)]">Still listening</h2>
                <p class="mt-1 text-xs leading-5 text-[var(--text-muted)]">
                  Run on the host network. Check Docker or WSL networking, VPN routes, AP isolation,
                  and multicast filtering.
                </p>
                <button
                  type="button"
                  phx-click="probe"
                  class="ui-secondary-button mt-3"
                  disabled={@probing? || !@status.network_available?}
                >
                  <.icon name="hero-arrow-path" class="size-3.5" /> Search again
                </button>
              </div>
            </div>
          </div>
        </div>

        <footer class="border-t border-[var(--line)] px-4 py-2.5">
          <div class="flex items-center justify-between gap-3 text-[0.68rem] text-[var(--text-faint)]">
            <span>
              <%= if @status.network_available? do %>
                Listening continuously
              <% else %>
                Network runtime disabled
              <% end %>
            </span>
            <span :if={@status.pending_count > 0} class="font-mono text-[var(--accent)]">
              {@status.pending_count} describing
            </span>
          </div>
        </footer>
      </section>

      <main
        id="device-detail-panel"
        class={[
          "min-h-0 overflow-hidden rounded-lg border border-[var(--line)] bg-[var(--surface)]",
          !@selected_device && "hidden lg:block"
        ]}
      >
        <%= if @selected_device do %>
          <div class="h-full overflow-y-auto">
            <header class="border-b border-[var(--line)] px-4 py-4 sm:px-6 sm:py-5">
              <.link
                patch={~p"/"}
                class="mb-4 inline-flex items-center gap-1.5 text-xs font-medium text-[var(--text-muted)] hover:text-[var(--text)] lg:hidden"
              >
                <.icon name="hero-arrow-left" class="size-4" /> All devices
              </.link>
              <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <.presence status={@selected_device.status} />
                    <span class="font-mono text-[0.68rem] text-[var(--text-faint)]">
                      {@selected_device.host}
                    </span>
                  </div>
                  <h1 class="mt-3 text-2xl font-semibold tracking-[-0.035em] text-[var(--text)] sm:text-3xl">
                    {@selected_device.name}
                  </h1>
                  <p class="mt-1 text-sm text-[var(--text-muted)]">
                    {device_subtitle(@selected_device)}
                  </p>
                </div>
                <div class="flex shrink-0 items-center gap-2">
                  <span class="rounded-full border border-[var(--line-strong)] px-2.5 py-1 text-xs text-[var(--text-muted)]">
                    {@selected_device.device_kind}
                  </span>
                  <span class="rounded-full border border-[var(--line-strong)] px-2.5 py-1 font-mono text-xs text-[var(--text-muted)]">
                    {@selected_device.service_count} services
                  </span>
                </div>
              </div>

              <div
                :if={@selected_device.description_error}
                id="description-error"
                class="mt-4 flex gap-3 rounded-md border border-[var(--warning-border)] bg-[var(--warning-soft)] p-3 text-sm"
              >
                <.icon
                  name="hero-exclamation-triangle"
                  class="mt-0.5 size-4 shrink-0 text-[var(--warning)]"
                />
                <div>
                  <p class="font-semibold text-[var(--text)]">Description unavailable</p>
                  <p class="mt-0.5 font-mono text-xs leading-5 text-[var(--text-muted)]">
                    {@selected_device.description_error}
                  </p>
                </div>
              </div>
            </header>

            <div class="space-y-8 px-4 py-6 sm:px-6">
              <section aria-labelledby="identity-heading">
                <div class="flex items-center justify-between gap-3">
                  <h2 id="identity-heading" class="section-heading">Identity</h2>
                  <a
                    :if={safe_http_url(@selected_device.location)}
                    href={@selected_device.location}
                    target="_blank"
                    rel="noreferrer"
                    class="ui-text-link"
                  >
                    Description <.icon name="hero-arrow-up-right" class="size-3.5" />
                  </a>
                </div>
                <dl class="mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-2">
                  <div class="detail-pair">
                    <dt>Device type</dt>
                    <dd class="font-mono">{@selected_device.device_type || "Not advertised"}</dd>
                  </div>
                  <div class="detail-pair">
                    <dt>UDN</dt>
                    <dd class="font-mono">{@selected_device.udn || @selected_device.identity}</dd>
                  </div>
                  <div class="detail-pair">
                    <dt>Local route</dt>
                    <dd class="font-mono">{@selected_device.local_address || "Unknown"}</dd>
                  </div>
                  <div class="detail-pair">
                    <dt>Remote endpoint</dt>
                    <dd class="font-mono">
                      {@selected_device.remote_endpoint || @selected_device.host}
                    </dd>
                  </div>
                  <div class="detail-pair">
                    <dt>Boot and configuration</dt>
                    <dd class="font-mono">
                      BOOTID {@selected_device.boot_id || "?"} / CONFIGID {@selected_device.config_id ||
                        "?"}
                    </dd>
                  </div>
                  <div class="detail-pair">
                    <dt>Cache lifetime</dt>
                    <dd>
                      {if(@selected_device.max_age,
                        do: "#{@selected_device.max_age} seconds",
                        else: "Unknown"
                      )}
                    </dd>
                  </div>
                </dl>
              </section>

              <section :if={@selected_device.status == :online} aria-labelledby="tree-heading">
                <div class="flex items-baseline justify-between gap-3">
                  <h2 id="tree-heading" class="section-heading">Device tree</h2>
                  <span class="text-xs text-[var(--text-faint)]">
                    {@selected_device.embedded_count} embedded
                  </span>
                </div>
                <div
                  id="device-nodes"
                  phx-update="stream"
                  class="mt-3 grid gap-2 sm:grid-cols-2"
                >
                  <article
                    :for={{dom_id, node} <- @streams.device_nodes}
                    id={dom_id}
                    class="rounded-md border border-[var(--line)] bg-[var(--surface-raised)] px-3.5 py-3"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <div class="min-w-0">
                        <h3 class="truncate text-sm font-semibold text-[var(--text)]">
                          {node.name}
                        </h3>
                        <p class="mt-1 truncate font-mono text-[0.67rem] text-[var(--text-faint)]">
                          {node.device_type || "Unknown device type"}
                        </p>
                      </div>
                      <span class="shrink-0 font-mono text-[0.65rem] text-[var(--text-muted)]">
                        {node.service_count} svc
                      </span>
                    </div>
                  </article>
                </div>
              </section>

              <section :if={@selected_device.status == :online} aria-labelledby="services-heading">
                <div class="flex items-baseline justify-between gap-3">
                  <h2 id="services-heading" class="section-heading">Capabilities</h2>
                  <span class="text-xs text-[var(--text-faint)]">Select a service to inspect</span>
                </div>
                <div
                  id="device-services"
                  phx-update="stream"
                  class="mt-3 overflow-hidden rounded-md border border-[var(--line)]"
                >
                  <button
                    :for={{dom_id, service} <- @streams.services}
                    id={dom_id}
                    type="button"
                    phx-click="inspect-service"
                    phx-value-id={service.id}
                    class={[
                      "grid w-full grid-cols-[minmax(0,1fr)_auto] gap-3 border-b border-[var(--line)] px-4 py-3 text-left transition last:border-b-0 hover:bg-[var(--surface-hover)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-[var(--accent)]",
                      @selected_service_id == service.id && "bg-[var(--accent-soft)]"
                    ]}
                  >
                    <span class="min-w-0">
                      <span class="flex items-center gap-2">
                        <span class="truncate text-sm font-semibold text-[var(--text)]">{service.name}</span>
                        <span
                          :if={service.evented?}
                          class="rounded-full border border-[var(--accent-border)] bg-[var(--accent-soft)] px-1.5 py-0.5 text-[0.62rem] font-semibold text-[var(--accent)]"
                        >
                          Evented
                        </span>
                      </span>
                      <span class="mt-1 block truncate font-mono text-[0.67rem] text-[var(--text-faint)]">
                        {service.service_type}
                      </span>
                      <span class="mt-1 block text-xs text-[var(--text-muted)]">
                        on {service.owner_name}
                      </span>
                    </span>
                    <.icon name="hero-chevron-right" class="mt-1 size-4 text-[var(--text-faint)]" />
                  </button>
                </div>
              </section>

              <section
                :if={@selected_service_id}
                id="service-inspector"
                aria-labelledby="service-inspector-heading"
                class="rounded-lg border border-[var(--accent-border)] bg-[var(--accent-soft)]"
              >
                <header class="flex items-start justify-between gap-4 border-b border-[var(--accent-border)] px-4 py-4 sm:px-5">
                  <div>
                    <p class="text-[0.68rem] font-semibold uppercase tracking-[0.1em] text-[var(--accent)]">
                      Service inspector
                    </p>
                    <h2
                      id="service-inspector-heading"
                      class="mt-1 text-lg font-semibold text-[var(--text)]"
                    >
                      {if(@service_detail,
                        do: @service_detail.summary.name,
                        else: "Loading service"
                      )}
                    </h2>
                  </div>
                  <button
                    type="button"
                    phx-click="close-service"
                    class="ui-icon-button"
                    title="Close service inspector"
                  >
                    <.icon name="hero-x-mark" class="size-4" />
                  </button>
                </header>

                <div
                  :if={@service_loading?}
                  id="service-loading"
                  class="flex items-center gap-3 px-5 py-6"
                >
                  <span class="size-4 animate-spin rounded-full border-2 border-[var(--line-strong)] border-t-[var(--accent)] motion-reduce:animate-none"></span>
                  <span class="text-sm text-[var(--text-muted)]">Reading the service description</span>
                </div>

                <div :if={@service_error} id="service-error" class="px-5 py-5">
                  <div class="rounded-md border border-[var(--danger-border)] bg-[var(--danger-soft)] p-3">
                    <p class="text-sm font-semibold text-[var(--danger)]">
                      Service description failed
                    </p>
                    <p class="mt-1 font-mono text-xs leading-5 text-[var(--text-muted)]">
                      {@service_error}
                    </p>
                  </div>
                </div>

                <div :if={@service_detail} class="space-y-6 px-4 py-5 sm:px-5">
                  <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
                    <dl class="min-w-0 space-y-1 text-xs">
                      <div class="flex gap-2">
                        <dt class="w-16 shrink-0 text-[var(--text-faint)]">Type</dt>
                        <dd class="truncate font-mono text-[var(--text-muted)]">
                          {@service_detail.summary.service_type}
                        </dd>
                      </div>
                      <div class="flex gap-2">
                        <dt class="w-16 shrink-0 text-[var(--text-faint)]">Owner</dt>
                        <dd class="truncate text-[var(--text-muted)]">
                          {@service_detail.summary.owner_name}
                        </dd>
                      </div>
                    </dl>
                    <button
                      :if={@service_detail.summary.evented?}
                      id="toggle-service-watch"
                      type="button"
                      phx-click="toggle-watch"
                      disabled={@watch_loading?}
                      class={[
                        "ui-secondary-button shrink-0",
                        @watch_subscription &&
                          "border-[var(--accent)] bg-[var(--accent)] text-white"
                      ]}
                    >
                      <.icon
                        name={if(@watch_subscription, do: "hero-stop", else: "hero-play")}
                        class="size-3.5"
                      />
                      <%= cond do %>
                        <% @watch_loading? -> %>
                          Subscribing
                        <% @watch_subscription -> %>
                          Stop live watch
                        <% true -> %>
                          Watch live
                      <% end %>
                    </button>
                  </div>

                  <div
                    :if={@watch_error}
                    id="watch-error"
                    class="rounded-md border border-[var(--danger-border)] bg-[var(--danger-soft)] p-3 font-mono text-xs text-[var(--danger)]"
                  >
                    {@watch_error}
                  </div>

                  <section
                    :if={@watch_subscription || @watch_loading?}
                    aria-labelledby="live-events-heading"
                  >
                    <div class="flex items-center justify-between gap-3">
                      <h3 id="live-events-heading" class="subsection-heading">Live state</h3>
                      <span
                        :if={@watch_subscription}
                        class="inline-flex items-center gap-1.5 text-[0.68rem] font-medium text-[var(--success)]"
                      >
                        <span class="size-1.5 rounded-full bg-current"></span> subscribed
                      </span>
                    </div>
                    <div
                      id="service-events"
                      phx-update="stream"
                      class="mt-2 max-h-72 overflow-y-auto rounded-md border border-[var(--line)] bg-[var(--surface)]"
                    >
                      <div
                        id="service-events-empty"
                        class="hidden only:flex min-h-20 items-center justify-center px-4 text-xs text-[var(--text-faint)]"
                      >
                        Waiting for the device's first notification
                      </div>
                      <article
                        :for={{dom_id, event} <- @streams.service_events}
                        id={dom_id}
                        class="grid grid-cols-[minmax(0,1fr)_auto] gap-3 border-b border-[var(--line)] px-3 py-2.5 last:border-b-0"
                      >
                        <div class="min-w-0">
                          <div class="flex items-center gap-2">
                            <h4 class="truncate text-xs font-semibold text-[var(--text)]">
                              {event.label}
                            </h4>
                            <span
                              :if={event_meta(event) != ""}
                              class="truncate font-mono text-[0.61rem] text-[var(--text-faint)]"
                            >
                              {event_meta(event)}
                            </span>
                          </div>
                          <p
                            :if={event.value}
                            class="mt-1 break-words font-mono text-[0.72rem] text-[var(--text-muted)]"
                          >
                            {event.value}
                          </p>
                          <p
                            :if={event.detail}
                            class="mt-1 break-words text-[0.72rem] text-[var(--text-muted)]"
                          >
                            {event.detail}
                          </p>
                        </div>
                        <time class="font-mono text-[0.62rem] text-[var(--text-faint)]">
                          {Calendar.strftime(event.occurred_at, "%H:%M:%S")}
                        </time>
                      </article>
                    </div>
                  </section>

                  <section aria-labelledby="actions-heading">
                    <h3 id="actions-heading" class="subsection-heading">Actions</h3>
                    <div
                      id="service-actions"
                      phx-update="stream"
                      class="mt-2 overflow-hidden rounded-md border border-[var(--line)] bg-[var(--surface)]"
                    >
                      <p
                        id="service-actions-empty"
                        class="hidden only:block px-3 py-4 text-xs text-[var(--text-faint)]"
                      >
                        This service declares no actions.
                      </p>
                      <details
                        :for={{dom_id, action} <- @streams.service_actions}
                        id={dom_id}
                        open={action.query_status != :idle}
                        class="group border-b border-[var(--line)] last:border-b-0"
                      >
                        <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-3 py-2.5 marker:hidden">
                          <span class="text-xs font-semibold text-[var(--text)]">{action.name}</span>
                          <span class="flex min-w-0 items-center gap-2">
                            <span class="hidden max-w-sm truncate font-mono text-[0.62rem] text-[var(--text-faint)] sm:block">
                              {action_signature(action)}
                            </span>
                            <.icon
                              name="hero-chevron-down"
                              class="size-3.5 text-[var(--text-faint)] transition group-open:rotate-180"
                            />
                          </span>
                        </summary>
                        <div class="border-t border-[var(--line)] bg-[var(--surface-subtle)] px-3 py-3">
                          <p class="font-mono text-[0.7rem] leading-5 text-[var(--text-muted)]">
                            {action_signature(action)}
                          </p>
                          <div :if={action.read_only_query} class="mt-3">
                            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
                              <p class="text-[0.7rem] leading-5 text-[var(--text-muted)]">
                                Read-only query. This does not change device or router state.
                              </p>
                              <button
                                id="invoke-external-address"
                                type="button"
                                phx-click="invoke-read-only-action"
                                phx-value-name={action.name}
                                disabled={action.query_status == :loading}
                                class="ui-secondary-button shrink-0"
                              >
                                <.icon
                                  name="hero-arrow-path"
                                  class={[
                                    "size-3.5",
                                    action.query_status == :loading &&
                                      "motion-safe:animate-spin"
                                  ]}
                                />
                                <%= if action.query_status == :loading do %>
                                  Querying
                                <% else %>
                                  {action.read_only_query.button_label}
                                <% end %>
                              </button>
                            </div>
                            <div
                              :if={action.query_status == :success}
                              id="external-address-result"
                              class="mt-3 rounded-md border border-[var(--success-border)] bg-[var(--success-soft)] px-3 py-2.5"
                            >
                              <p class="text-[0.62rem] font-semibold uppercase tracking-[0.08em] text-[var(--success)]">
                                {action.query_result.label}
                              </p>
                              <p class="mt-1 font-mono text-sm font-semibold text-[var(--text)]">
                                {action.query_result.value}
                              </p>
                            </div>
                            <div
                              :if={action.query_status == :error}
                              id="action-invocation-error"
                              class="mt-3 rounded-md border border-[var(--danger-border)] bg-[var(--danger-soft)] px-3 py-2.5"
                            >
                              <p class="text-[0.62rem] font-semibold uppercase tracking-[0.08em] text-[var(--danger)]">
                                Query failed
                              </p>
                              <p class="mt-1 break-words font-mono text-[0.7rem] text-[var(--text-muted)]">
                                {action.query_error}
                              </p>
                            </div>
                          </div>
                          <p
                            :if={is_nil(action.read_only_query)}
                            class="mt-2 text-[0.7rem] text-[var(--text-faint)]"
                          >
                            Observation mode shows the contract but does not invoke this action.
                          </p>
                        </div>
                      </details>
                    </div>
                  </section>

                  <section aria-labelledby="state-heading">
                    <h3 id="state-heading" class="subsection-heading">State variables</h3>
                    <div
                      id="state-variables"
                      phx-update="stream"
                      class="mt-2 grid gap-2 sm:grid-cols-2"
                    >
                      <p
                        id="state-variables-empty"
                        class="hidden only:block text-xs text-[var(--text-faint)]"
                      >
                        This service declares no state variables.
                      </p>
                      <article
                        :for={{dom_id, variable} <- @streams.state_variables}
                        id={dom_id}
                        class="rounded-md border border-[var(--line)] bg-[var(--surface)] px-3 py-2.5"
                      >
                        <div class="flex items-start justify-between gap-2">
                          <h4 class="truncate text-xs font-semibold text-[var(--text)]">
                            {variable.name}
                          </h4>
                          <span
                            :if={variable.sends_events?}
                            class="shrink-0 text-[0.6rem] font-semibold uppercase tracking-[0.08em] text-[var(--accent)]"
                          >
                            evented
                          </span>
                        </div>
                        <p class="mt-1 font-mono text-[0.65rem] text-[var(--text-faint)]">
                          {variable.data_type}
                          <span :if={variable_constraint(variable)}>
                            / {variable_constraint(variable)}
                          </span>
                        </p>
                      </article>
                    </div>
                  </section>
                </div>
              </section>

              <details class="rounded-md border border-[var(--line)]">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-semibold text-[var(--text)] marker:hidden">
                  Protocol details
                  <.icon name="hero-chevron-down" class="size-4 text-[var(--text-faint)]" />
                </summary>
                <dl class="grid gap-3 border-t border-[var(--line)] bg-[var(--surface-subtle)] px-4 py-4 text-xs sm:grid-cols-2">
                  <div class="detail-pair">
                    <dt>Location</dt>
                    <dd class="font-mono">{@selected_device.location}</dd>
                  </div>
                  <div class="detail-pair">
                    <dt>Server</dt>
                    <dd class="font-mono">{@selected_device.server || "Not advertised"}</dd>
                  </div>
                  <div class="detail-pair">
                    <dt>Serial</dt>
                    <dd class="font-mono">
                      {@selected_device.serial_number || "Not advertised"}
                    </dd>
                  </div>
                  <div class="detail-pair">
                    <dt>Parsing</dt>
                    <dd>
                      {if(@selected_device.parsing_error?,
                        do: "Degraded SSDP envelope",
                        else: "Parsed cleanly"
                      )}
                    </dd>
                  </div>
                </dl>
              </details>
            </div>
          </div>
        <% else %>
          <.empty_state
            title="Select a device"
            detail="Choose a live roster entry to inspect its identity, embedded device tree, services, and evented state."
            icon="hero-cursor-arrow-rays"
          />
        <% end %>
      </main>

      <aside
        id="activity-rail-panel"
        class="hidden min-h-0 flex-col overflow-hidden rounded-lg border border-[var(--line)] bg-[var(--surface)] xl:flex"
      >
        <header class="flex items-start justify-between gap-3 border-b border-[var(--line)] px-4 py-4">
          <div>
            <p class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] text-[var(--text-faint)]">
              Live
            </p>
            <h2 class="mt-1 text-base font-semibold tracking-[-0.02em] text-[var(--text)]">
              Network changes
            </h2>
          </div>
          <.link navigate={~p"/activity"} class="ui-icon-button" title="Open full activity">
            <.icon name="hero-arrows-pointing-out" class="size-4" />
          </.link>
        </header>
        <div
          id="activity-rail"
          phx-update="stream"
          class="min-h-0 flex-1 overflow-y-auto px-4"
        >
          <div
            id="rail-activity-empty"
            class="hidden only:flex min-h-40 flex-col items-center justify-center text-center"
          >
            <.icon name="hero-signal" class="size-5 text-[var(--text-faint)]" />
            <p class="mt-2 text-xs text-[var(--text-faint)]">Waiting for network changes</p>
          </div>
          <.activity_item
            :for={{dom_id, activity} <- @streams.rail_activity}
            id={dom_id}
            activity={activity}
            compact
          />
        </div>
        <footer class="border-t border-[var(--line)] px-4 py-3 text-[0.68rem] text-[var(--text-faint)]">
          Raw SSDP packets are available in Activity.
        </footer>
      </aside>
    </div>
  </div>
</Layouts.app>
